#pragma mode( separator(.,;) integer(h64) )
USES HP;

{$ADDON hpfont.h}
LOCAL Small := {$I SmallFontCodes.h};
LOCAL Large := {$I LargeFontCodes.h};
LOCAL Font10 := {$I Font10.h};

EXPORT START()
BEGIN
  LOCAL f:=Small, w:="NORMAL";
  LOCAL f1, f2;
  LOCAL txt:="TI-84 CE: Small Font";

  WHILE 1 DO
    RECT(2^24-1);
    DRAWMENU({"Small", "Large", "", "NORMAL", "BOLD", "EXIT"});
    HP.TEXTOUT(txt, G0, 8, 8, f, 0, RGB(0,0,0,255), IFTE(w=="BOLD",2,1));
    HP.TEXTOUT(w, G0, 8, 32, Font10, 0, RGB(0,0,0,255), 2);
    
    LOCAL ms;
    REPEAT
      ms:=MOUSE;
    UNTIL SIZE(ms(1))==5;
  
    LOCAL tx := ms(1,1), ty := ms(1,2);
    IF ty < 200 THEN CONTINUE; END;
      
    LOCAL m:=1+FLOOR(tx/53);
    CASE
      IF m == 1 THEN
        Small▶f;
        "TI-84 CE: Small Font"▶txt;
      END;
      IF m == 2 THEN
        Large▶f;
        "TI-84 CE: Large Font"▶txt;
      END;
      IF m == 4 THEN
        "NORMAL"▶w;
      END;
      IF m == 5 THEN
        "BOLD"▶w;
      END;
      IF m == 6 THEN
        RETURN;
      END;
    DEFAULT
      CONTINUE;
    END;
  END;
END;

export RESET()
begin
    return 0;
end;
